# TNVED_BOT — пример конфигурации.
# Скопируй в .env и заполни. Файл .env в git не попадает.
# НИКОГДА не вписывай реальные значения в этот файл.

# --- Telegram (обязательно) ---
# Токен от @BotFather
BOT_TOKEN=
# Разрешённые Telegram user ID через запятую. Первый = администратор.
# Свой ID можно узнать, написав боту — он вернёт его в сообщении об отказе.
ALLOWED_USER_IDS=

# --- Пути ---
DB_PATH=data/tnved.db
PHOTO_DIR=data/photos
NOMENCLATURE_DIR=data/nomenclature
BACKUP_DIR=data/backups
LOG_DIR=logs

# --- ИИ через CLI claude (ключи НЕ нужны — используется локальная авторизация claude) ---
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_TIMEOUT_TEXT=90
CLAUDE_TIMEOUT_VISION=120
CLAUDE_MAX_RETRIES=2
CLAUDE_MAX_CONCURRENCY=2
CLAUDE_BREAKER_FAILURES=5
CLAUDE_BREAKER_COOLDOWN_MINUTES=5

# --- Логика классификации ---
FTS_CANDIDATES=40
CONFIDENCE_ACCEPT=0.80
CONFIDENCE_CLARIFY=0.45
MAX_CLARIFY_ROUNDS=3
SESSION_TIMEOUT_MINUTES=30

# --- Хранение данных ---
PHOTO_TTL_HOURS=48
PHOTO_META_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90
BACKUP_KEEP=7
MAX_PHOTO_MB=10

# --- Лимиты ---
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=100
GLOBAL_LIMIT_PER_DAY=300

# --- Прочее ---
LOG_LEVEL=INFO
ADMIN_ALERTS=true
STALE_UPDATE_MINUTES=5
