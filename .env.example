# TNVED_BOT — пример конфигурации.
# Скопируй в .env и заполни. Файл .env в git не попадает.
# НИКОГДА не вписывай реальные значения в этот файл.

# --- Telegram (обязательно) ---
# Токен от @BotFather
BOT_TOKEN=

# Администраторы — числовые Telegram user ID через запятую, без пробелов.
# Это аварийный вход и право управлять доступом: /users /adduser /deluser /invite,
# а также /health /stats /reload_db.
# Обычные пользователи здесь НЕ перечисляются — они хранятся в таблице allowed_users
# и добавляются командами бота, без перезапуска.
# Свой ID можно узнать, написав боту — он вернёт его в сообщении об отказе.
ADMIN_USER_IDS=

# --- Приглашения ---
INVITE_TTL_HOURS=24
INVITE_ATTEMPTS_PER_HOUR=5

# --- Пути ---
DB_PATH=data/tnved.db
PHOTO_DIR=data/photos
NOMENCLATURE_DIR=data/nomenclature
BACKUP_DIR=data/backups
LOG_DIR=logs

# --- ИИ через CLI claude (ключи НЕ нужны — используется локальная авторизация claude) ---
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_TIMEOUT_TEXT=90
CLAUDE_TIMEOUT_VISION=120
CLAUDE_MAX_RETRIES=2
CLAUDE_MAX_CONCURRENCY=2
CLAUDE_BREAKER_FAILURES=5
CLAUDE_BREAKER_COOLDOWN_MINUTES=5

# --- Логика классификации ---
FTS_CANDIDATES=40
CONFIDENCE_ACCEPT=0.80
CONFIDENCE_CLARIFY=0.45
MAX_CLARIFY_ROUNDS=3
SESSION_TIMEOUT_MINUTES=30

# --- Таможенная справка (пошлина, НДС, разрешительные документы) ---
# Единственный выход бота в интернет помимо Telegram: справка по коду берётся со страницы
# ifcg.ru и кешируется в БД. REFERENCE_ENABLED=false полностью отключает сеть — бот
# продолжает работать, но покажет только ставку из локального справочника.
REFERENCE_ENABLED=true
REFERENCE_TIMEOUT=12
REFERENCE_TTL_DAYS=30
# Повторный проход с примерами реальных деклараций, когда модель не уверена в коде.
# Стоит одного лишнего обращения к ИИ, зато закрывает разрыв в словаре.
REFERENCE_SAMPLES=true
# Сколько соседних кодов с меньшей ставкой показывать. 0 — не показывать вовсе.
MAX_SAVINGS=2

# --- Хранение данных ---
PHOTO_TTL_HOURS=48
PHOTO_META_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90
BACKUP_KEEP=7
MAX_PHOTO_MB=10

# --- Лимиты ---
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=100
GLOBAL_LIMIT_PER_DAY=300

# --- Прочее ---
LOG_LEVEL=INFO
ADMIN_ALERTS=true
STALE_UPDATE_MINUTES=5
